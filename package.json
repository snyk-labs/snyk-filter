{
  "name": "snyk-filter",
  "version": "1.0.0",
  "description": "Module to consume json output from Snyk CLI for advanced filtering and results display",
  "main": "index.js",
  "scripts": {
    "test": "mocha ./tests && npm run lint",
    "snyk-protect": "npx @snyk/protect",
    "prepare": "npm run snyk-protect",
    "lint": "prettier --check **/*.js",
    "format": "prettier --write **/*.js",
    "build:bin": "pkg . --fallback-to-source --output dist/snyk-filter"
  },
  "pkg": {
    "scripts": [
      "index.js",
      "lib/**/*.js"
    ]
  },
  "author": "Antoine Arlaud, antoine@snyk.io",
  "license": "ISC",
  "bin": {
    "snyk-filter": "./index.js"
  },
  "dependencies": {
    "chalk": "4.1.2",
    "debug": "4.3.4",
    "js-yaml": "4.3.2",
    "minimist": "1.2.8",
    "node-jq": "6.0.1"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.21.0",
    "lodash": "^4.18.1",
    "mocha": "10.1.0",
    "prettier": "2.8.8"
  },
  "engines": {
    "node": ">=22"
  }
}
